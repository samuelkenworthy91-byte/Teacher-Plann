# Where the database lives. On most setups this is already provided
# by your host — copy to .env for local development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Push notifications (optional — if left blank, MarkFlow generates and
# stores its own VAPID keys on first run, which is fine for personal use).
# Generate a pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourschool.edu

# Protects /api/push/digest if you expose it to the internet.
# Callers must send:  Authorization: Bearer <secret>
# CRON_SECRET=
